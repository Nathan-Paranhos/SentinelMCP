# Copie para .env (não versionado) e substitua os valores. Em produção, use um cofre de segredos.
# Gere senhas fortes, por exemplo: openssl rand -base64 32

# Superusuário do container PostgreSQL (somente compose local)
POSTGRES_PASSWORD=troque-esta-senha

# Login de menor privilégio usado pela API (membro de sentinel_app, sem BYPASSRLS)
SENTINEL_APP_DB_PASSWORD=troque-esta-senha-tambem

# Ambiente da API no compose. Development habilita login de desenvolvimento e tokens mock.
ASPNETCORE_ENVIRONMENT=Development

# OAuth/OIDC (deixe vazio para desabilitar)
Authentication__Mcp__Authority=
Authentication__Mcp__Audience=sentinel-mcp
Authentication__Web__Authority=
Authentication__Web__ClientId=
Authentication__Web__ClientSecret=
