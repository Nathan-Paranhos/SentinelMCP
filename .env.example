# Configurações do Sentinel-MCP
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# Conexão PostgreSQL
ConnectionStrings__Database=Host=localhost;Port=5432;Database=sentinel_mcp;Username=postgres;Password=postgres;Include Error Detail=true;

# Autenticação e Segurança
Authentication__Authority=http://localhost:8080/realms/sentinel
Authentication__Audience=sentinel-mcp
Authentication__RequireHttpsMetadata=false
Authentication__AllowMockTokens=true
Sentinel__AdminApiKey=dev_admin_secret_key_change_in_prod

# Retenção de Comprovantes (dias)
Sentinel__ReceiptRetentionDays=30
