{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Sentinel": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Sentinel": {
    "StorageProvider": "PostgreSQL",
    "AutoMigrate": false,
    "AllowMockTokens": false,
    "Web": {
      "EnableDevLogin": false
    }
  }
}
