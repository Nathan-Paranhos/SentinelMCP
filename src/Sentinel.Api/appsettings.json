{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sentinel": {
    "StorageProvider": "InMemory",
    "AutoMigrate": false,
    "AllowMockTokens": false,
    "Web": {
      "EnableDevLogin": false
    },
    "Mcp": {
      "AllowedOrigins": []
    },
    "Retention": {
      "Enabled": true,
      "ReceiptRetentionDays": 30,
      "IntervalMinutes": 360
    },
    "RateLimit": {
      "McpPerMinute": 300,
      "WebPerMinute": 120,
      "LoginPerMinute": 20
    },
    "ApiKeys": []
  },
  "Authentication": {
    "Mcp": {
      "Authority": "",
      "Audience": "sentinel-mcp"
    },
    "Web": {
      "Authority": "",
      "ClientId": ""
    }
  }
}
