{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=sentinel_mcp;Username=postgres;Password=postgrespassword;Include Error Detail=true;"
  },
  "Sentinel": {
    "StorageProvider": "InMemory",
    "AutoMigrate": true,
    "AllowMockTokens": true,
    "ApiKeys": {
      "sentinel-dev-agent-key": {
        "Subject": "agent-dev-1",
        "Issuer": "https://auth.sentinel.dev",
        "ClientId": "claude-code",
        "Scopes": [ "read:memory", "write:decision", "write:incident" ],
        "Role": "Contributor"
      },
      "sentinel-dev-maintainer-key": {
        "Subject": "maintainer-alice",
        "Issuer": "https://auth.sentinel.dev",
        "ClientId": null,
        "Scopes": [ "read:memory", "write:decision", "write:incident", "admin:all" ],
        "Role": "Maintainer"
      }
    }
  }
}
